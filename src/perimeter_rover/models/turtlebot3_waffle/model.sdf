<?xml version="1.0"?>
<sdf version="1.9">
  <model name="turtlebot3_waffle">
    <pose>0 0 0.10 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <mass>1.8</mass>
        <inertia>
          <ixx>0.012</ixx><iyy>0.014</iyy><izz>0.020</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.28 0.26 0.09</size></box></geometry>
      </collision>
      <visual name="waffle_lower_plate">
        <pose>0 0 -0.025 0 0 0</pose>
        <geometry><box><size>0.28 0.26 0.035</size></box></geometry>
        <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="waffle_upper_plate">
        <pose>-0.015 0 0.018 0 0 0</pose>
        <geometry><box><size>0.23 0.23 0.025</size></box></geometry>
        <material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.88 0.89 0.90 1</diffuse></material>
      </visual>
      <visual name="lidar">
        <pose>-0.06 0 0.045 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.14 -0.067 1.5708 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.00008</ixx><iyy>0.00008</iyy><izz>0.00008</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>4</effort><velocity>20</velocity></limit></axis>
    </joint>

    <link name="right_wheel">
      <pose>0 -0.14 -0.067 1.5708 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.00008</ixx><iyy>0.00008</iyy><izz>0.00008</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>4</effort><velocity>20</velocity></limit></axis>
    </joint>

    <link name="camera_link">
      <pose>0.13 0 0.07 0 0 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="camera_body">
        <geometry><box><size>0.055 0.07 0.045</size></box></geometry>
        <material><ambient>0.06 0.10 0.13 1</ambient><diffuse>0.08 0.18 0.24 1</diffuse></material>
      </visual>
      <sensor name="rgb_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_fixed_joint" type="fixed">
      <parent>base_link</parent><child>camera_link</child>
    </joint>

    <link name="caster_link">
      <pose>-0.105 0 -0.055 0 0 0</pose>
      <inertial><mass>0.04</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.018</radius></sphere></geometry></collision>
      <visual name="visual"><geometry><sphere><radius>0.018</radius></sphere></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
    </link>
    <joint name="caster_fixed_joint" type="fixed"><parent>base_link</parent><child>caster_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.28</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </model>
</sdf>